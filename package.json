{
  "name": "stynx-workspace",
  "private": true,
  "version": "0.2.0",
  "license": "BUSL-1.1",
  "description": "STYNX monorepo foundation for backend, frontend, apps, and tooling",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "turbo run build --filter='./packages/*' --filter='./packages-web/*' --filter='./tools/*' --filter='./test/*' --filter=@stynx-nyx/docs-site",
    "lint": "turbo run lint --filter='./packages/*' --filter='./packages-web/*' --filter='./tools/*' --filter='./test/*'",
    "lint:tests": "eslint --config tools/eslint-config/test.mjs --no-error-on-unmatched-pattern 'packages/*/test/**/*.{spec,test}.ts' 'packages-web/*/test/**/*.{spec,test}.ts'",
    "typecheck": "turbo run typecheck --filter='./packages/*' --filter='./packages-web/*' --filter='./tools/*' --filter=@stynx-nyx/docs-site",
    "test": "turbo run test --filter='./packages/*' --filter='./packages-web/*' --filter='./tools/*' --filter='./test/*'",
    "test:int": "turbo run test:int --concurrency=1 --filter='./packages/*'",
    "check:engines": "node scripts/check-engines.mjs",
    "lint:deadcode": "knip --config tools/repo-config/knip.config.ts --no-config-hints",
    "lint:deps": "depcheck --ignore-patterns='**/*.test.ts,**/*.spec.ts' --skip-missing --ignores='@aarusso-nyx/devai,@commitlint/cli,@commitlint/config-conventional,@stryker-mutator/typescript-checker,@stryker-mutator/vitest-runner,@vitest/coverage-v8,eslint-plugin-boundaries,eslint-plugin-jsdoc,github-actionlint,prettier'",
    "lint:migrations": "pnpm --filter migration-linter run lint:repo",
    "lint:cycles": "madge --circular packages/ packages-web/ tools/ --extensions ts,mjs --exclude '(^|/)(dist|build|coverage|node_modules)/'",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:acceptance": "node scripts/verify-db-acceptance.mjs",
    "api:coverage": "node scripts/verify-api-coverage.mjs --strict",
    "api:docs:write": "node scripts/verify-api-coverage.mjs --write-openapi --strict",
    "api:contract": "node scripts/verify-openapi-contract.mjs",
    "api:baselines": "node scripts/verify-public-api-baselines.mjs",
    "api:baselines:write": "node scripts/verify-public-api-baselines.mjs --write",
    "sdk:route-smoke": "node scripts/verify-sdk-route-smoke.mjs",
    "check:rls-negative": "node scripts/verify-rls-negative.mjs",
    "frontend:production-smoke": "node scripts/verify-frontend-production.mjs",
    "frontend:a11y-gate": "node scripts/verify-frontend-a11y-gate.mjs",
    "production:readiness-reference": "node scripts/verify-production-readiness-reference.mjs",
    "stynx-boundary:check": "node --experimental-strip-types scripts/verify-stynx-boundary.ts",
    "ci:stynx": "pnpm check:engines && pnpm api:coverage && pnpm api:contract && pnpm sdk:route-smoke && pnpm check:rls-negative && pnpm frontend:production-smoke && pnpm frontend:a11y-gate && pnpm production:readiness-reference && pnpm lint && pnpm lint:tests && pnpm lint:deadcode && pnpm lint:deps && pnpm lint:cycles && pnpm typecheck && pnpm test && pnpm test:int && pnpm build && pnpm run doctor",
    "ci:stynx:full": "pnpm ci:stynx && pnpm test:e2e && pnpm test:mutation && pnpm test:perf && pnpm check:rls-smoke",
    "ci:stynx:release": "pnpm security:release && pnpm release:provenance && pnpm release:policy && pnpm api:baselines && pnpm release:consumer-fixtures && pnpm release:drafts",
    "ci:reference-apps": "pnpm --filter @stynx-nyx/reference-api build && pnpm --filter @stynx-nyx/reference-api test && pnpm --filter @stynx-nyx/reference-api test:int && pnpm --filter @stynx-nyx/reference-web build && pnpm --filter @stynx-nyx/reference-web build:web",
    "ci:local": "bash scripts/ci-local/run.sh",
    "clean": "node scripts/clean-workspace.mjs",
    "clean:dry": "node scripts/clean-workspace.mjs --dry-run",
    "changeset": "changeset",
    "release:status": "changeset status --since origin/main --output .changeset/status.json",
    "release:drafts": "pnpm release:status && node scripts/generate-release-drafts.mjs",
    "release:policy": "node scripts/verify-release-policy.mjs && node scripts/verify-web-sourcemaps.mjs",
    "release:provenance": "node scripts/verify-release-provenance.mjs",
    "release:consumer-fixtures": "node scripts/verify-consumer-fixtures.mjs",
    "release:web-sourcemaps": "node scripts/verify-web-sourcemaps.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs --write",
    "security:sbom:check": "node scripts/generate-sbom.mjs --check",
    "security:licenses": "node scripts/verify-license-policy.mjs",
    "security:secrets": "node scripts/verify-secret-scan.mjs",
    "security:release": "pnpm security:sbom:check && pnpm security:licenses && pnpm security:secrets && pnpm audit --prod",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:publish:ci": "node scripts/changesets-publish-ci.mjs",
    "doctor": "node scripts/stynx-doctor.mjs",
    "test:e2e": "turbo run test:e2e --force --filter='./packages/*' --filter='./packages-web/*' --filter='./reference/*'",
    "test:mutation": "pnpm -r --filter \"./packages/*\" --filter \"./packages-web/*\" --workspace-concurrency=1 stryker",
    "check:rls-smoke": "bash scripts/check-rls-smoke.sh",
    "smoke:local": "pnpm --filter @stynx-nyx/reference-api smoke:local",
    "prepare": "husky",
    "test:coverage": "turbo run test:coverage --filter='./packages/*' --filter='./packages-web/*'",
    "test:coverage:aggregate": "turbo run test:coverage --filter='./packages/*' --filter='./packages-web/*'",
    "test:perf": "node scripts/perf-smoke.mjs",
    "devai:trace:verify": "node scripts/verify-devai-trace.mjs",
    "devai:doctor": "devai doctor --repo-root . --format json",
    "devai:api-contracts": "pnpm api:coverage && pnpm api:contract && pnpm api:baselines && pnpm sdk:route-smoke",
    "devai:lint-families": "pnpm lint && pnpm lint:tests && pnpm lint:deadcode && pnpm lint:deps && pnpm lint:migrations && pnpm lint:cycles && pnpm lint:workflows",
    "devai:db-rls": "pnpm --filter @stynx-nyx/cli build && node packages/cli/dist/cli/src/main.js migrate up --database-url \"${STYNX_DATABASE_URL:-${DATABASE_URL:-}}\" && pnpm db:verify && pnpm db:acceptance && pnpm check:rls-negative && pnpm check:rls-smoke",
    "devai:docs": "pnpm --dir docs/site build",
    "i18n:check": "node tools/i18n-extract.mjs --check",
    "i18n:extract": "node tools/i18n-extract.mjs --write"
  },
  "devDependencies": {
    "@aarusso-nyx/devai": "1.1.7",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@swc/core": "^1.15.33",
    "@types/node": "24.12.4",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^3",
    "depcheck": "^1.4.7",
    "eslint": "^10.2.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "github-actionlint": "1.7.12",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "knip": "^6.7.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,cts,mts}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,scss,html}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "7.29.7",
      "@grpc/grpc-js": "1.14.4",
      "@types/node@24.12.4": "24.12.4",
      "@vitest/coverage-v8@3": "3.2.7",
      "body-parser@1": "1.20.6",
      "body-parser@2": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "adm-zip": "0.6.0",
      "dockerode": "5.0.0",
      "dompurify@3": "3.4.13",
      "esbuild@0.28.0": "0.28.1",
      "esbuild@^0.27.0": "0.28.1",
      "form-data@4": "4.0.6",
      "handlebars": "4.7.9",
      "http-proxy-middleware@2": "2.0.10",
      "image-size@2": "link:tools/image-size-safe",
      "joi": "18.2.1",
      "fast-uri@3": "3.1.5",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "launch-editor@2": "2.14.1",
      "less": "4.9.0",
      "lighthouse": "13.4.1",
      "linkify-it@5": "5.0.2",
      "markdown-it@14": "14.2.0",
      "mermaid": "11.16.1",
      "multer": "2.2.0",
      "piscina@5": "5.2.0",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.26",
      "protobufjs@7": "7.6.5",
      "qs@6": "6.15.2",
      "serialize-javascript": "7.0.5",
      "shell-quote": "1.10.0",
      "svgo@3": "3.3.4",
      "immutable@5": "5.1.8",
      "ip-address": "10.3.1",
      "tar@7": "7.5.21",
      "tmp": "0.2.7",
      "undici@7": "7.29.0",
      "uuid": "14.0.0",
      "vite@7": "7.3.6",
      "vitest@3": "3.2.7",
      "webpack-dev-server@5": "5.2.6",
      "webpackbar": "7.0.0",
      "websocket-driver": "0.7.5",
      "ws@7": "7.5.11",
      "ws@8": "8.21.0"
    }
  },
  "stynx": {
    "boundary": {
      "roots": [
        "reference",
        "domain",
        "packages",
        "packages-web"
      ],
      "allowedPackages": [
        "@stynx-nyx/"
      ],
      "forbiddenImports": [],
      "requireStynxPackages": []
    },
    "apiCoverage": {
      "openapiPath": "docs/framework/contracts/openapi.json",
      "sourceRoots": [
        "reference/api/src",
        "packages"
      ],
      "routePrefix": ""
    },
    "dbAcceptance": {
      "ddlPaths": [
        "database/ddl/*.sql"
      ],
      "seedPaths": [
        "database/seed/*.sql"
      ],
      "requiredSchemas": [
        "auth",
        "audit",
        "storage"
      ],
      "requiredTables": [],
      "requiredRlsTables": []
    }
  }
}
