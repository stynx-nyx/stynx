erride an existing tenant header"},{"id":"15","name":"@stynx-nyx/angular-tenancy tenant switcher ignores empty selections and emits manual tenant changes"},{"id":"16","name":"@stynx-nyx/angular-tenancy constructs the tenant switcher in an injection context"},{"id":"17","name":"@stynx-nyx/angular-tenancy tenant picker renders only on multi-tenant first load and projects content after selection"},{"id":"18","name":"@stynx-nyx/angular-tenancy tenant picker accepts explicit tenant options and stays passive for single tenants or active contexts"}]},"test/provide-tenancy.node.spec.ts":{"tests":[{"id":"21","name":"provideTenancy SSR window provider returns null when no browser window is available"}]},"test/tenant-contract-depth.spec.ts":{"tests":[{"id":"19","name":"@stynx-nyx/angular-tenancy W04 tenant contract depth exposes resolved manual tenant context to injected consumers and attaches the canonical tenant header"},{"id":"20","name":"@stynx-nyx/angular-tenancy W04 tenant contract depth leaves requests unmodified when no tenant resolves so callers can reject missing tenant context explicitly"}]}},"thresholds":{"break":90,"high":100,"low":90}}
