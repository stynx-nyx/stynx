.0","testFiles":{"test/provider-depth.spec.ts":{"tests":[{"id":"24","name":"@stynx-nyx/angular provider depth maps backend StynxError envelopes to typed client errors and banner state"},{"id":"25","name":"@stynx-nyx/angular provider depth registers default tokens, csp nonce, and the HTTP interceptor chain"}]},"test/stynx-angular.spec.ts":{"tests":[{"id":"0","name":"@stynx-nyx/angular renders the empty-state component with input-driven copy and tone"},{"id":"1","name":"@stynx-nyx/angular generates UUIDv7-shaped request ids for API headers"},{"id":"2","name":"@stynx-nyx/angular falls back to Math.random when web crypto is unavailable"},{"id":"3","name":"@stynx-nyx/angular generates deterministic UUIDv7 bytes from fallback entropy and timestamp"},{"id":"4","name":"@stynx-nyx/angular generates deterministic UUIDv7 bytes from web crypto entropy and timestamp"},{"id":"5","name":"@stynx-nyx/angular preserves caller request ids"},{"id":"6","name":"@stynx-nyx/angular applies request-id, tenant, and auth headers and refreshes after 401"},{"id":"7","name":"@stynx-nyx/angular refreshes after a mapped unauthorized SDK error"},{"id":"8","name":"@stynx-nyx/angular passes auth through when bearer mode is disabled and shows a re-login action when refresh is empty"},{"id":"9","name":"@stynx-nyx/angular skips auth without a provider and does not retry non-retryable errors"},{"id":"10","name":"@stynx-nyx/angular does not treat malformed bearer-looking authorization headers as retryable attempts"},{"id":"11","name":"@stynx-nyx/angular rethrows errors inside the injected zone and ticks non-destroyed apps after delivery"},{"id":"12","name":"@stynx-nyx/angular skips the post-error tick when the injected app ref is already destroyed"},{"id":"13","name":"@stynx-nyx/angular leaves bearer requests unchanged when the provider has no token"},{"id":"14","name":"@stynx-nyx/angular passes unauthenticated mapped 401 errors through without refresh"},{"id":"15","name":"@stynx-nyx/angular maps server errors through ErrorBannerService"},{"id":"16","name":"@stynx-nyx/angular maps HTTP error context and omits falsy status from banners"},{"id":"17","name":"@stynx-nyx/angular maps HTTP errors without optional code, status, or context fields"},{"id":"18","name":"@stynx-nyx/angular passes non-HTTP errors through without showing a banner"},{"id":"19","name":"@stynx-nyx/angular resolves tenant context from query, subdomain, then default resolver"},{"id":"20","name":"@stynx-nyx/angular tracks toast service signal and observable lifecycles"},{"id":"21","name":"@stynx-nyx/angular keeps empty-state component inputs as configured"},{"id":"22","name":"@stynx-nyx/angular provides standalone stynx defaults with feature-provider overrides"},{"id":"23","name":"@stynx-nyx/angular registers module error mapping outside auth refresh handling"}]}},"thresholds":{"break":90,"high":100,"low":90}}
