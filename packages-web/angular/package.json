{
  "name": "@stynx-nyx/angular",
  "version": "1.2.0",
  "license": "BUSL-1.1",
  "author": "Antonio Augusto Russo <aarusso@nyxk.com.br>",
  "description": "Angular core integration for stynx",
  "exports": {
    ".": {
      "types": "./dist/types/stynx-nyx-angular.d.ts",
      "default": "./dist/fesm2022/stynx-nyx-angular.mjs"
    },
    "./testing": {
      "types": "./dist/types/stynx-nyx-angular-testing.d.ts",
      "default": "./dist/fesm2022/stynx-nyx-angular-testing.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint --config ../../tools/eslint-config/angular.mjs \"src/**/*.ts\"",
    "test": "vitest run --config ./vitest.config.ts",
    "stryker": "NODE_OPTIONS=\"--disable-warning=ExperimentalWarning --experimental-vm-modules\" pnpm exec stryker run stryker.conf.mjs",
    "build:tsc": "tsc -p tsconfig.json",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage --coverage.reporter=json --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@stynx-nyx/angular-tenancy": "workspace:*",
    "@stynx-nyx/sdk": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@angular/common": ">=22.0.0 <23",
    "@angular/core": ">=22.0.0 <23",
    "@angular/router": ">=22.0.0 <23"
  },
  "devDependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/compiler-cli": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-browser-dynamic": "22.1.6",
    "@angular/router": "22.1.6",
    "@types/node": "24.13.4",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.2",
    "ng-packagr": "22.1.1",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stynx-nyx/stynx.git",
    "directory": "packages-web/angular"
  }
}
