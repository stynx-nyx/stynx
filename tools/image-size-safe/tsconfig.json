{
  "compilerOptions": {
    "target": "ES2021",
    "module": "node16",
    "allowJs": false,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./lib",
    "removeComments": false,
    "strict": true,
    "alwaysStrict": true,
    "moduleResolution": "node16",
    "lib": ["ES2021", "DOM"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": ["lib/**/*"],
  "typedocOptions": {
    "excludeExternals": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "entryPoints": ["lib/index.ts"],
    "out": "docs"
  }
}
