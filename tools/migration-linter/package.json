{
  "name": "@stynx-nyx/migration-linter",
  "version": "3.0.1",
  "license": "BUSL-1.1",
  "author": "Antonio Augusto Russo <aarusso@nyxk.com.br>",
  "type": "module",
  "description": "Archive-aware SQL migration linter for the STYNX monorepo",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stynx-migration-lint": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:coverage": "pnpm run build && node ../../scripts/node-test-coverage.mjs dist/test/migration-linter.spec.js dist/test/context-rules.spec.js",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config ../../tools/eslint-config/lib.mjs \"src/**/*.ts\"",
    "lint:repo": "pnpm run build && node scripts/lint-repo.mjs",
    "test": "pnpm run build && node --test --test-concurrency=1 dist/test/migration-linter.spec.js dist/test/context-rules.spec.js"
  },
  "dependencies": {
    "pg-query-emscripten": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stynx-nyx/stynx.git",
    "directory": "tools/migration-linter"
  }
}
