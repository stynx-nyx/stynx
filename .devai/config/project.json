{
  "schemaVersion": "1.0.0",
  "project_type": "platform-package",
  "authority_enforcement": {
    "mode": "host-integrated",
    "adapter_config": ".devai/config/github-actions-host-adapter.json"
  },
  "profile": "tier1",
  "constitution": {
    "version": "1.0.1",
    "sha256": "ff8c4f099a284b1b42f980742b20c849379ba4e3f357905f36a87648ae3fdeae"
  },
  "devai_version": "1.5.0",
  "repo": {
    "kind": "library"
  },
  "docs": {
    "builder": "docusaurus",
    "build_command": "pnpm --dir docs/site build",
    "ia": {
      "path_overrides": {
        "dev/operations": "meta/ops",
        "dev/security": "meta/security"
      }
    }
  },
  "ci_economy": {
    "attested_rc": {
      "profile": "rc",
      "transport": "protected-tag-v1",
      "tag_prefix": "devai-local-evidence/",
      "binding": "exact-tree",
      "required_check": "verified-local-rc",
      "failure_mode": "fail-closed",
      "local_only_nodes": [
        "test:mutation"
      ]
    }
  }
}
