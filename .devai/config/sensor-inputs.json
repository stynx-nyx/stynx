{
  "schemaVersion": "1.0.0",
  "inputs": {
    "spec_depth": {
      "adrDir": "law/adr",
      "invariantsDir": "law/invariants"
    },
    "test_security_coverage": {
      "testGlobs": [
        "packages/*/test",
        "packages-web/*/test",
        "reference/*/test",
        "domain/*/api/test",
        "domain/*/web/test",
        "test",
        "tools",
        "infra",
        "scripts"
      ]
    },
    "test_performance_coverage": {
      "testGlobs": [
        "packages/*/test",
        "packages-web/*/test",
        "reference/*/test",
        "domain/*/api/test",
        "domain/*/web/test",
        "test",
        "tools",
        "infra",
        "scripts"
      ]
    },
    "test_robustness_coverage": {
      "testGlobs": [
        "packages/*/test",
        "packages-web/*/test",
        "reference/*/test",
        "domain/*/api/test",
        "domain/*/web/test",
        "test",
        "tools",
        "infra",
        "scripts"
      ]
    },
    "test_idiomaticity": {
      "testGlobs": [
        "packages/*/test",
        "packages-web/*/test",
        "reference/*/test",
        "domain/*/api/test",
        "domain/*/web/test",
        "test",
        "tools",
        "infra",
        "scripts"
      ]
    },
    "type_check": {
      "taskId": "typecheck",
      "population": "workspace-typecheck"
    },
    "plant_depth": {
      "excludeGlobs": [
        "packages-web/sdk/src/generated/**"
      ]
    },
    "harness_idiomaticity": {
      "minWorkflowsForReusableCheck": 5
    },
    "harness_green_main": {
      "workflow": "ci.yml",
      "event": "pull_request",
      "headBranch": "*",
      "baseBranch": "main",
      "attempts": "last",
      "includeCancelled": false,
      "lookbackDays": 30,
      "minimumSample": 20,
      "outcomeUnit": "pull-request-final-head",
      "excludedJobs": []
    },
    "harness_performance": {
      "workflow": "ci.yml",
      "event": "pull_request",
      "headBranch": "*",
      "baseBranch": "main",
      "attempts": "last",
      "includeCancelled": false,
      "lookbackDays": 30,
      "minimumSample": 10,
      "excludedJobs": []
    },
    "harness_robustness": {
      "workflow": "ci.yml",
      "event": "pull_request",
      "headBranch": "*",
      "baseBranch": "main",
      "attempts": "last",
      "includeCancelled": false,
      "lookbackDays": 30,
      "minimumSample": 20,
      "excludedJobs": []
    },
    "inventory_routes": {
      "framework": "angular",
      "scanDirs": [
        "reference/web/src",
        "packages-web/angular-flow/src",
        "packages-web/angular-iam/src",
        "packages-web/angular-profile/src",
        "packages-web/angular-audit/src"
      ]
    },
    "build": {
      "taskId": "build",
      "population": "workspace-build"
    },
    "perf_test": {
      "taskId": "test:performance",
      "population": "cold-unit-perf"
    },
    "migration_check": {
      "taskId": "db:rls",
      "population": "migration-rls"
    }
  },
  "surfaces": {
    "http": true,
    "database": true,
    "rbac": true,
    "actions": false
  }
}
