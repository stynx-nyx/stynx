# Lockfiles have their own canonical formatting (pnpm/npm); running
# prettier over them produces enormous, semantically-meaningless diffs and
# fights the package manager's own writer on every future install.
pnpm-lock.yaml
**/pnpm-lock.yaml
**/package-lock.json
**/yarn.lock

# Generated output, never hand-formatted.
.devai/**
**/dist/**
**/coverage/**
**/.turbo/**
**/node_modules/**

# i18n-extract writes these manifests in its canonical JSON format.
packages-web/*/src/i18n/keys.json
