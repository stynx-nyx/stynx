{
  "schemaVersion": "1.0.0",
  "policy_id": "stynx.devai-adoption",
  "policy_version": "1.5.0",
  "project": {
    "project_type": "platform-package",
    "repo": {
      "kind": "library"
    },
    "docs": {
      "builder": "docusaurus",
      "build_command": "pnpm --dir docs/site build",
      "ia": {
        "path_overrides": {
          "dev/operations": "meta/ops",
          "dev/security": "meta/security"
        }
      }
    }
  },
  "ci_economy": {
    "attested_rc": {
      "profile": "rc",
      "transport": "protected-tag-v1",
      "tag_prefix": "devai-local-evidence/",
      "binding": "exact-tree",
      "required_check": "verified-local-rc",
      "failure_mode": "fail-closed",
      "local_only_nodes": ["test:mutation"]
    }
  },
  "release_verification": {
    "schemaVersion": "1.4.0",
    "policy_id": "stynx.release-verification",
    "policy_version": "1.4.0",
    "release_unit": "stynx-workspace",
    "version_source": "package.json",
    "default_support": "current",
    "required_check": "stynx-release-gate",
    "capability_tasks": {
      "formatting-hygiene": ["lint:families"],
      "lint": ["lint:families"],
      "type-integrity": ["typecheck"],
      "schema-consistency": ["api:contracts"],
      "secret-scan": ["security"],
      "path-portability": ["security"],
      "package-integrity": ["release:prepare"],
      "exact-candidate": ["release:prepare"],
      "affected-checks": ["test:unit"],
      "dependent-checks": ["test:integration"],
      "build-integrity": ["build"],
      "unit": ["test:unit"],
      "integration": ["test:integration"],
      "e2e": ["test:e2e"],
      "consumer": ["reference:apps"],
      "api-compatibility": ["api:contracts"],
      "migration": ["db:rls"],
      "rollback": ["db:rls"],
      "adopter-materialization": ["doctor"],
      "security": ["security"],
      "database": ["db:rls"],
      "tenancy": ["db:rls"],
      "provenance": ["release:prepare"],
      "reproducibility": ["release:prepare"],
      "operational-matrix": ["test:local-full"]
    },
    "risk_capabilities": {},
    "mutation_roster": []
  },
  "domains": {
    "client": ["COVERAGE", "ERROR", "FLOW", "PRIVACY", "RBAC"]
  },
  "thresholds": {
    "lint": {
      "max_errors": 0,
      "max_warnings": 0
    }
  },
  "scorecard_na": {
    "schemaVersion": "1.0.0",
    "cells": [
      {
        "cell": "F1:T1",
        "reason": "Spec x Contract validation has no live emitter in DEVAI 2.3.0: the sensor registry binds no sensor to F1:T1, so the cell has no measurable subject until the package ships one (ADR-DEVAI-ADOPTION-0014).",
        "constitution_anchor": "Article 5"
      },
      {
        "cell": "F4:T5",
        "reason": "Inventory x Idiomaticity is the degenerate cell Article 5 names: inventory artifacts are derived deterministically from F1, F2 and F3 and never authored, so idiomaticity has no authored subject to measure.",
        "constitution_anchor": "Article 5"
      }
    ]
  },
  "glob_guards": {
    "schemaVersion": "1.0.0",
    "guards": []
  }
}
