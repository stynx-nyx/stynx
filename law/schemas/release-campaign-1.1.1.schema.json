{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stynx.dev/schemas/release-campaign-1.1.1.schema.json",
  "title": "STYNX 1.1.1 release campaign policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policy_id",
    "status",
    "authority",
    "owner_decision_date",
    "baseline",
    "pr_a_changeset_policy",
    "candidate",
    "devai",
    "approved_first_publications",
    "existing_private_packages",
    "publishable_packages",
    "mutation_packages",
    "registry_anomaly",
    "forbidden_without_separate_owner_authorization"
  ],
  "properties": {
    "$schema": { "const": "../schemas/release-campaign-1.1.1.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "policy_id": { "const": "stynx.release-campaign-1.1.1" },
    "status": { "const": "accepted-preparation-policy" },
    "authority": { "const": "Architect" },
    "owner_decision_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "projected_version", "projection_status"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "projected_version": { "const": "1.0.0" },
        "projection_status": { "const": "accidental-non-candidate" }
      }
    },
    "pr_a_changeset_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "baseline_commit",
        "baseline_tree",
        "current_version",
        "candidate_version",
        "changesets",
        "release_status_projection",
        "version_projection"
      ],
      "properties": {
        "kind": { "const": "campaign-preparation-only" },
        "baseline_commit": { "$ref": "#/$defs/sha1" },
        "baseline_tree": { "$ref": "#/$defs/sha1" },
        "current_version": { "const": "1.0.0" },
        "candidate_version": { "const": "1.1.1" },
        "changesets": { "const": "forbidden" },
        "release_status_projection": { "const": "empty-non-promoting" },
        "version_projection": { "const": "deferred-to-pr-b" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "canonical_line",
        "publishable_count",
        "mutation_count",
        "existing_private_count",
        "approved_first_publication_count"
      ],
      "properties": {
        "version": { "const": "1.1.1" },
        "canonical_line": { "const": "1.x" },
        "publishable_count": { "const": 44 },
        "mutation_count": { "const": 38 },
        "existing_private_count": { "const": 38 },
        "approved_first_publication_count": { "const": 6 }
      }
    },
    "devai": { "$ref": "#/$defs/devai" },
    "approved_first_publications": { "$ref": "#/$defs/sixPackages" },
    "existing_private_packages": { "$ref": "#/$defs/thirtyEightPackages" },
    "publishable_packages": { "$ref": "#/$defs/fortyFourPackages" },
    "mutation_packages": { "$ref": "#/$defs/thirtyEightPackages" },
    "registry_anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "candidate", "allowed_effect"],
      "properties": {
        "package": { "const": "@stynx-nyx/angular-profile" },
        "version": { "const": "2.0.0" },
        "candidate": { "const": "1.1.1" },
        "allowed_effect": { "const": "registry-monotonicity-exception" }
      }
    },
    "forbidden_without_separate_owner_authorization": {
      "const": [
        "publication",
        "registry-mutation",
        "latest-movement",
        "tag-creation",
        "manual-dist-tag-change",
        "deprecation",
        "deletion",
        "repository-settings-change",
        "branch-protection-bypass",
        "test-weakening",
        "version-substitution"
      ]
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packageName": { "type": "string", "pattern": "^@stynx-nyx/[a-z0-9-]+$" },
    "sixPackages": {
      "const": [
        "@stynx-nyx/jobs",
        "@stynx-nyx/mobile-runtime",
        "@stynx-nyx/notifications",
        "@stynx-nyx/offline-sync",
        "@stynx-nyx/outbox",
        "@stynx-nyx/worklist"
      ]
    },
    "thirtyEightPackages": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packageName" }
    },
    "fortyFourPackages": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packageName" }
    },
    "devai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "tarball",
        "integrity",
        "shasum",
        "sha256",
        "source_commit",
        "source_tree",
        "signed_tag_object",
        "verifier_materialization"
      ],
      "properties": {
        "package": { "const": "@aarusso-nyx/devai" },
        "version": { "const": "1.2.13" },
        "tarball": {
          "const": "https://npm.pkg.github.com/download/@aarusso-nyx/devai/1.2.13/6e766187269db2e5f494786adc7c00c62acad006"
        },
        "integrity": {
          "const": "sha512-QM9PyGNtPRzhRBsYTiJFg6eM3OVw4/fSyAPnn1h8yHBq20GcEBrp91wxzqlvGREGkOAzezwvK3INze2OjqZV3Q=="
        },
        "shasum": { "const": "6e766187269db2e5f494786adc7c00c62acad006" },
        "sha256": { "const": "47f07c9ea4eecfb06c9ee6d0ec01ea46e3e76231e4c6151ddbde73ada26122d0" },
        "source_commit": { "const": "5df84ca88179a8fe53cc29cf8201c32c9439d552" },
        "source_tree": { "const": "36b5c714e8da19b5f42fb7db57d8fe9783c99b4f" },
        "signed_tag_object": { "const": "32c9b98603d49fcabbf1db220b2f7438e0a40fc6" },
        "verifier_materialization": { "$ref": "#/$defs/verifierMaterialization" }
      }
    },
    "verifierMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_version",
        "canonical_policy_path",
        "canonical_policy_sha256",
        "package",
        "authentication",
        "workflow_permissions",
        "materialization",
        "verifier",
        "external_duplicate",
        "adopter_fallbacks"
      ],
      "properties": {
        "provider_version": { "const": "1.2.13" },
        "canonical_policy_path": {
          "const": "dist/law/policy/trusted-local-rc-verifier-package.json"
        },
        "canonical_policy_sha256": {
          "const": "9990ce69fee0bca529b6337334a403cb569a200ad508c00b08d9e60b563696a0"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "registry",
            "tarball",
            "shasum_sha1",
            "integrity_sri",
            "release_source"
          ],
          "properties": {
            "name": { "const": "@aarusso-nyx/devai" },
            "version": { "const": "1.2.12" },
            "registry": { "const": "https://npm.pkg.github.com" },
            "tarball": {
              "const": "https://npm.pkg.github.com/download/@aarusso-nyx/devai/1.2.12/04a8bb1edd4f85f8a3663be931634f4e077139b2"
            },
            "shasum_sha1": { "const": "04a8bb1edd4f85f8a3663be931634f4e077139b2" },
            "integrity_sri": {
              "const": "sha512-WXd1oRdBDenC/VOLFzquIdGZ5giBAT7DBPppdtUDfCUQKioflzL2xO1iOmYKf5E6G5dDuRCgmMDoUOoq1Mxsgw=="
            },
            "release_source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "commit", "tree"],
              "properties": {
                "repository": { "const": "aarusso-nyx/devai" },
                "commit": { "const": "e365abdcf245882e3f5ee1fb0ea8ef7bebe3ab0d" },
                "tree": { "const": "5a89a8c482e0f145708b311904bd86bd7bd45939" }
              }
            }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secret", "scope", "github_token_fallback"],
          "properties": {
            "secret": { "const": "PACKAGES_READ_TOKEN" },
            "scope": { "const": "materialization-step-only" },
            "github_token_fallback": { "const": false }
          }
        },
        "workflow_permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contents", "packages", "checks"],
          "properties": {
            "contents": { "const": "read" },
            "packages": { "const": "read" },
            "checks": { "const": "write" }
          }
        },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "package_lifecycle_scripts",
            "candidate_product_execution",
            "validate_before_extraction",
            "reject_archive_entries"
          ],
          "properties": {
            "root": { "const": "runner-temporary-storage" },
            "package_lifecycle_scripts": { "const": false },
            "candidate_product_execution": { "const": false },
            "validate_before_extraction": {
              "const": [
                "package-name",
                "package-version",
                "tarball-url",
                "tarball-sha1",
                "tarball-sri",
                "release-source-commit",
                "release-source-tree"
              ]
            },
            "reject_archive_entries": {
              "const": ["absolute-path", "path-traversal", "symlink", "hardlink", "special-file"]
            }
          }
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "provenance_sha256",
            "source_commit",
            "payload_file_count",
            "binaries",
            "reject_population"
          ],
          "properties": {
            "root": { "const": "dist/runtime/evidence-verification" },
            "provenance_sha256": {
              "const": "e6be4198ded731b9733c8e5c720fc5beb1ec8393a1eda01b76e6119b172d17c0"
            },
            "source_commit": { "const": "9e115014f8da5a16be526c7da5207bc0aae0801b" },
            "payload_file_count": { "const": 21 },
            "binaries": {
              "const": {
                "devai-evidence-policy": "./dist/runtime/evidence-verification/src/build-policy-cli.js",
                "devai-evidence-verify": "./dist/runtime/evidence-verification/src/cli.js",
                "devai-evidence-bundle-verify": "./dist/runtime/evidence-verification/src/bundle-cli.js",
                "devai-evidence-export": "./dist/runtime/evidence-verification/src/export-cli.js",
                "devai-evidence-publish": "./dist/runtime/evidence-verification/src/publish-cli.js"
              }
            },
            "reject_population": {
              "const": [
                "missing-file",
                "extra-file",
                "symlink",
                "special-file",
                "digest-drift",
                "binary-map-drift"
              ]
            }
          }
        },
        "external_duplicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "required", "sole_trust_root"],
          "properties": {
            "name": { "const": "DEVAI_LEDGER_VERIFIER_PROVENANCE_SHA256" },
            "required": { "const": true },
            "sole_trust_root": { "const": false }
          }
        },
        "adopter_fallbacks": { "const": [] }
      }
    }
  }
}
