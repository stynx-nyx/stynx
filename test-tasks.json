        { "kind": "exact", "pattern": "scripts/lib/mutation-evidence.mjs" },
        { "kind": "exact", "pattern": "scripts/lib/mutation-roster.mjs" },
        { "kind": "prefix", "pattern": "tools/stryker/" },
        { "kind": "exact", "pattern": "tools/repo-config/test-policy.json" }
