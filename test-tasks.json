    {
      "nodeId": "release:prepare",
      "dependencies": [
        "api:contracts",
        "lint:families",
        "test:e2e",
        "docs",
        "test:mutation",
        "test:performance",
        "security",
        "doctor"
      ],
      "argv": ["pnpm", "run", "ci:stynx:release"],
      "cwd": ".",
      "runner": "stynx-release-v1",
      "inputSelectors": [
