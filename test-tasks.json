        "DOCKER_CONFIG",
        "DOCKER_HOST",
        "DATABASE_URL",
        "STYNX_DATABASE_URL",
        "STYNX_TEST_PG_HOST",
        "STYNX_TEST_PG_PORT",
        "STYNX_TEST_PG_USER",
        "STYNX_TEST_PG_PASSWORD",
        "STYNX_TEST_PG_SOCKET_DIR",
        "STYNX_TEST_PG_TEMPLATE",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_REUSE_ENABLE"
      ],
      "outputContract": { "kind": "command", "requiredResult": "pass" }
    },
    {
      "nodeId": "build",
      "dependencies": ["typecheck"],
      "argv": ["pnpm", "run", "build"],
      "cwd": ".",
      "runner": "turbo-build-v1",
      "inputSelectors": [
        { "kind": "glob", "pattern": "packages/*/src/**" },
        { "kind": "glob", "pattern": "packages-web/*/src/**" },
        { "kind": "prefix", "pattern": "domain/" },
        { "kind": "prefix", "pattern": "reference/" },
        { "kind": "prefix", "pattern": "tools/" },
        { "kind": "exact", "pattern": "turbo.json" }
      ],
      "toolchainKeys": ["node", "pnpm", "typescript"],
      "allowlistedEnv": ["CI", "NODE_ENV"],
      "outputContract": {
        "kind": "command",
        "requiredResult": "pass",
        "paths": [
