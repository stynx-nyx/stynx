        "DOCKER_CONFIG",
        "DOCKER_HOST",
        "DATABASE_URL",
        "STYNX_DATABASE_URL",
        "STYNX_TEST_PG_HOST",
        "STYNX_TEST_PG_PORT",
        "STYNX_TEST_PG_USER",
        "STYNX_TEST_PG_PASSWORD",
        "STYNX_TEST_PG_SOCKET_DIR",
        "STYNX_TEST_PG_TEMPLATE",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_REUSE_ENABLE"
