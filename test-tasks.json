        { "kind": "prefix", "pattern": "docs/adopters/stynx/" },
        { "kind": "prefix", "pattern": "scripts/" },
        { "kind": "exact", "pattern": "package.json" },
        { "kind": "exact", "pattern": "pnpm-lock.yaml" },
        { "kind": "exact", "pattern": "test-tasks.json" }
      ],
      "toolchainKeys": ["node", "pnpm"],
