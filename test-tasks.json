  "profiles": [
    {
      "profileId": "affected",
      "mode": "affected",
      "requiredNodes": ["engines", "trace", "doctor"],
      "eligibleNodes": [
        "engines",
        "api:contracts",
        "lint:families",
        "typecheck",
        "test:unit",
        "test:integration",
        "build",
        "reference:apps",
        "db:rls",
        "test:e2e",
        "docs",
        "test:mutation",
        "test:performance",
        "security",
        "trace",
        "doctor",
        "test:local-full",
        "release:prepare"
      ]
    },
    {
      "profileId": "rc",
      "mode": "fixed",
      "requiredNodes": ["release:prepare"]
    }
  ]
}
