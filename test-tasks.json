{
  "schemaVersion": "1.0.0",
  "descriptorVersion": "stynx-devai-1.2.0-v1",
  "repositoryId": "stynx-nyx/stynx",
  "fallbackNodeId": "test:local-full",
  "dynamicFallbackSelectors": [
    { "kind": "prefix", "pattern": "law/" },
    { "kind": "prefix", "pattern": "product/" },
    { "kind": "prefix", "pattern": ".devai/" },
    { "kind": "prefix", "pattern": ".github/" },
    { "kind": "exact", "pattern": "package.json" },
    { "kind": "exact", "pattern": "pnpm-lock.yaml" },
    { "kind": "exact", "pattern": "pnpm-workspace.yaml" },
    { "kind": "exact", "pattern": "turbo.json" }
  ],
  "tasks": [
    {
      "nodeId": "engines",
      "dependencies": [],
      "argv": ["pnpm", "run", "check:engines"],
      "cwd": ".",
      "runner": "node-script-v1",
      "inputSelectors": [
        { "kind": "exact", "pattern": "package.json" },
        { "kind": "exact", "pattern": "pnpm-lock.yaml" },
        { "kind": "exact", "pattern": "pnpm-workspace.yaml" },
        { "kind": "exact", "pattern": ".node-version" }
      ],
      "toolchainKeys": ["node", "pnpm"],
      "allowlistedEnv": ["CI"],
      "outputContract": { "kind": "command", "requiredResult": "pass" }
    },
    {
      "nodeId": "api:contracts",
      "dependencies": ["build"],
      "argv": ["pnpm", "run", "devai:api-contracts"],
      "cwd": ".",
      "runner": "stynx-contracts-v1",
      "inputSelectors": [
        { "kind": "prefix", "pattern": "packages/contracts/" },
        { "kind": "prefix", "pattern": "packages/cli/" },
        { "kind": "prefix", "pattern": "reference/api/" },
        { "kind": "prefix", "pattern": "domain/" },
        { "kind": "prefix", "pattern": "docs/framework/contracts/" },
        { "kind": "glob", "pattern": "scripts/verify-*api*.mjs" },
        { "kind": "glob", "pattern": "scripts/verify-*route*.mjs" }
      ],
      "toolchainKeys": ["node", "pnpm", "typescript"],
      "allowlistedEnv": ["CI"],
      "outputContract": { "kind": "command", "requiredResult": "pass" }
    },
