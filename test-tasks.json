        "STYNX_DATABASE_URL",
        "STYNX_TEST_PG_HOST",
        "STYNX_TEST_PG_PORT",
        "STYNX_TEST_PG_USER",
        "STYNX_TEST_PG_PASSWORD",
        "STYNX_TEST_PG_SOCKET_DIR",
        "STYNX_TEST_PG_TEMPLATE"
