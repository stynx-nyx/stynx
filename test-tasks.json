        { "kind": "prefix", "pattern": "packages-web/" },
        { "kind": "prefix", "pattern": "domain/" },
        { "kind": "prefix", "pattern": "reference/" },
        { "kind": "prefix", "pattern": "tools/" },
        { "kind": "prefix", "pattern": "scripts/" },
        { "kind": "prefix", "pattern": ".github/workflows/" },
        { "kind": "glob", "pattern": "*.config.*" }
      ],
      "toolchainKeys": ["node", "pnpm", "typescript"],
      "allowlistedEnv": ["CI"],
      "outputContract": { "kind": "command", "requiredResult": "pass" }
