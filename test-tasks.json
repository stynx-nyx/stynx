      "toolchainKeys": ["node", "pnpm", "vitest", "typescript", "postgres"],
      "allowlistedEnv": [
        "CI",
        "DOCKER_CONFIG",
        "DOCKER_HOST",
        "DATABASE_URL",
        "STYNX_DATABASE_URL",
        "STYNX_TEST_PG_HOST",
        "STYNX_TEST_PG_PORT",
        "STYNX_TEST_PG_USER",
        "STYNX_TEST_PG_PASSWORD",
        "STYNX_TEST_PG_SOCKET_DIR",
        "STYNX_TEST_PG_TEMPLATE",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_REUSE_ENABLE"
      ],
      "outputContract": {
        "kind": "mutation-report-set-discovery-v1",
        "workspaceRoots": ["packages", "packages-web"],
        "testPolicyPath": "tools/repo-config/test-policy.json",
        "artifactRoot": ".devai/state/check-cache/v1/artifacts/mutation",
        "summaryPath": ".devai/state/check-cache/v1/artifacts/mutation/summary.json"
      }
    },
