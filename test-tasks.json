      "nodeId": "trace",
      "dependencies": ["engines"],
      "argv": ["pnpm", "run", "devai:trace:verify"],
      "cwd": ".",
      "runner": "stynx-trace-v1",
      "inputSelectors": [
        { "kind": "exact", "pattern": "law/trace.json" },
        { "kind": "prefix", "pattern": "law/invariants/" },
        { "kind": "prefix", "pattern": "scripts/" },
        { "kind": "glob", "pattern": "packages/*/test/**" },
        { "kind": "glob", "pattern": "packages-web/*/test/**" },
        { "kind": "glob", "pattern": "reference/*/test/**" },
        { "kind": "glob", "pattern": "tools/*/test/**" }
      ],
      "toolchainKeys": ["node", "pnpm"],
      "allowlistedEnv": ["CI"],
      "outputContract": { "kind": "command", "requiredResult": "pass" }
