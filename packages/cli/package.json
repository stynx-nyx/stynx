{
  "name": "@stynx-nyx/cli",
  "version": "3.0.0",
  "license": "BUSL-1.1",
  "author": "Antonio Augusto Russo <aarusso@nyxk.com.br>",
  "description": "CLI for bootstrapping, doctor checks, migrations, privacy ROPA, and adoption helpers",
  "type": "module",
  "main": "dist/cli/src/index.js",
  "types": "dist/cli/src/index.d.ts",
  "bin": {
    "stynx": "dist/cli/src/main.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/src/index.d.ts",
      "import": "./dist/cli/src/index.js",
      "default": "./dist/cli/src/index.js"
    }
  },
  "files": [
    "dist",
    "engines"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config ../../tools/eslint-config/lib.mjs \"src/**/*.ts\"",
    "test": "vitest run --config ./vitest.config.ts",
    "test:int": "node ../../test/packages/cli-generator/run-integration.mjs",
    "test:adopt": "vitest run --config ./vitest.config.ts test/adopt.spec.ts",
    "stryker": "pnpm exec stryker run stryker.conf.mjs",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage --coverage.reporter=json --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@stynx-nyx/data": "workspace:*",
    "@stynx-nyx/privacy": "workspace:*",
    "commander": "^15.0.0",
    "pg": "^8.22.0",
    "typescript": "~6.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "^8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stynx-nyx/stynx.git",
    "directory": "packages/cli"
  }
}
